VG_ENVIRONMENT_NAME=vg-stage-local
VG_STAGE_HOST=stage.example.test
VG_STAGE_HTTPS_PORT=8443

# Every deployable image must be a registry reference pinned by sha256.
VG_API_IMAGE=registry.invalid/videograbber-api@sha256:REPLACE_WITH_64_HEX
VG_WORKER_IMAGE=registry.invalid/videograbber-worker@sha256:REPLACE_WITH_64_HEX
VG_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_HEX
VG_CADDY_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX
VG_BOT_API_IMAGE=aiogram/telegram-bot-api@sha256:REPLACE_WITH_64_HEX

VG_AUTH_ISSUER=https://auth.stage.example.test
VG_WORKER_ID=00000000-0000-4000-8000-000000000001
VG_EGRESS_PROXY_URI=http://egress-proxy:3128
VG_TELEGRAM_BOT_API_BASE=https://api.telegram.org

# Safe defaults. Live selling and retention are not enabled by this file.
Payments__LiveEnabled=false
Auth__DevelopmentIssuerEnabled=false
Retention__Enabled=false
VG_PAYMENT_CATALOG_PATH=

# Paths point to protected files. Do not put their contents in this env file.
VG_POSTGRES_PASSWORD_FILE=C:/secure/vg-stage/postgres_password
VG_MIGRATION_DSN_FILE=C:/secure/vg-stage/migration_dsn
VG_API_DSN_FILE=C:/secure/vg-stage/api_dsn
VG_ADMIN_DSN_FILE=C:/secure/vg-stage/admin_dsn
VG_LEDGER_DSN_FILE=C:/secure/vg-stage/ledger_dsn
VG_OPERATIONS_DSN_FILE=C:/secure/vg-stage/operations_dsn
VG_WORKER_TOKEN_FILE=C:/secure/vg-stage/worker_token
VG_SESSION_KEY_FILE=C:/secure/vg-stage/session_key
VG_TELEGRAM_BOT_TOKEN_FILE=C:/secure/vg-stage/telegram_bot_token
VG_TELEGRAM_API_ID_FILE=C:/secure/vg-stage/telegram_api_id
VG_TELEGRAM_API_HASH_FILE=C:/secure/vg-stage/telegram_api_hash
