VG_TELEGRAM_API_BASE_URL=https://api.telegram.org
VG_PLATFORM_LEASE_KEY_ID=vg-lease-2026-09

# Safe defaults. Live selling and retention are not enabled by this file.
Payments__LiveEnabled=false
Auth__DevelopmentIssuerEnabled=false
Retention__Enabled=false
VG_RETENTION_ENABLED=false
VG_RETENTION_QUALIFIED=false
VG_RETENTION_DRY_RUN_CLEAN=false
VG_RETENTION_DRY_RUN_UTC=
VG_RETENTION_APPROVED=false
VG_LAST_BACKUP_UTC=
VG_PAYMENT_CATALOG_PATH=/etc/videograbber/payment-catalog.json

# Paths point to protected files. Do not put their contents in this env file.
VG_POSTGRES_PASSWORD_FILE=C:/secure/vg-stage/postgres_password
