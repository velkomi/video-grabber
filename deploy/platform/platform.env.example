VG_YOUTUBE_POT_IMAGE=brainicism/bgutil-ytdlp-pot-provider@sha256:ed86b6fdd5e430ddd7c8ce1adb55e1ab54db7c7dbc1bcbf3a82454a85b971164
VG_SOCIAL_EGRESS_IMAGE=registry.invalid/videograbber-social-egress@sha256:REPLACE_WITH_64_HEX
VG_BOT_API_IMAGE=aiogram/telegram-bot-api@sha256:REPLACE_WITH_64_HEX

VG_AUTH_ISSUER=https://auth.stage.example.test
VG_PLATFORM_PUBLIC_URL=https://videograbber.srv1902378.hstgr.cloud/
VG_WEB_AUTH_RETURN_URI=https://videograbber.srv1902378.hstgr.cloud/web/
