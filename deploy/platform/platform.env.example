VG_ENVIRONMENT_NAME=vg-stage-local
VG_STAGE_HOST=videograbber.srv1902378.hstgr.cloud
VG_STAGE_HTTP_PORT=19230
VG_STAGE_HTTPS_PORT=8443

# Every deployable image must be a registry reference pinned by sha256.
VG_API_IMAGE=registry.invalid/videograbber-api@sha256:REPLACE_WITH_64_HEX
VG_WORKER_IMAGE=registry.invalid/videograbber-worker@sha256:REPLACE_WITH_64_HEX
VG_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_HEX
VG_CADDY_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX
