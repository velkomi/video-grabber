{
  admin off
  auto_https disable_redirects
}

https://{$VG_STAGE_HOST} {
  tls internal
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors https://web.telegram.org https://telegram.org"
    -Server
  }

  @upload path_regexp upload ^/v1/desktop-worker/devices/[^/]+/uploads/[^/]+$
  handle @upload {
    request_body {
      max_size 4GB
    }
    reverse_proxy api:8080 {
      flush_interval -1
    }
  }

  handle {
    request_body {
      max_size 8MB
    }
    reverse_proxy api:8080
  }
}
